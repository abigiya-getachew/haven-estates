# Public site configuration
# Canonical URL for metadata, sitemap, and absolute links (ARCHITECTURE.md 13.4).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon database connection string.
# Get this from your Neon project dashboard → Connection Details.
# DATABASE_URL=postgresql://user:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# Server-only configuration. Leave unset while a service is not in use.
# RESEND_API_KEY=your-resend-api-key
# CONTACT_EMAIL_TO=agency@example.com
# ADMIN_EMAIL_ALLOWLIST=admin@example.com
# WHATSAPP_BUSINESS_NUMBER=251900000000
